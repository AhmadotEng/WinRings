#include <Windows.h>
#include "../shared/WinRingsIdentity.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION WINRINGS_PRODUCT_VERSION_MAJOR,WINRINGS_PRODUCT_VERSION_MINOR,WINRINGS_PRODUCT_VERSION_PATCH,WINRINGS_PRODUCT_VERSION_BUILD
 PRODUCTVERSION WINRINGS_PRODUCT_VERSION_MAJOR,WINRINGS_PRODUCT_VERSION_MINOR,WINRINGS_PRODUCT_VERSION_PATCH,WINRINGS_PRODUCT_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "WinRings"
            VALUE "FileDescription", "WinRings Explorer Shell & Top Bar Module"
            VALUE "FileVersion", WINRINGS_PRODUCT_VERSION_STR_A
            VALUE "InternalName", "WinRingsShell.dll"
            VALUE "OriginalFilename", "WinRingsShell.dll"
            VALUE "ProductName", WINRINGS_PRODUCT_NAME_A
            VALUE "ProductVersion", WINRINGS_PRODUCT_VERSION_STR_A
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
